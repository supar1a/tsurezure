// つれづれ — data model
//
// アカウントはない。ブラウザに残るクッキーが、そのまま「その人」を指す。
// 名前は最初に一度きいて、それだけ。照合するものが何もないので、
// なりすましは原理的に防げない。そこは仲間うちであることに委ねている。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// 名乗り。名前のほかに持つものがない。
model User {
  id           String   @id @default(cuid())
  name         String
  createdAt    DateTime @default(now())
  /// 最後に投げたグループ。次に書くとき、先にチェックしておく。
  lastPlaceIds String[] @default([])

  sessions    Session[]
  memberships Membership[]
  slips       Slip[]
}

/// ブラウザに置いたクッキーの控え。
model Session {
  token     String   @id
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 仲間うちの閉じたグループ。この URL を渡された人が入れる。
model Place {
  id        String   @id @default(cuid())
  /// 招待 URL の実体。これを知っていることが、そのまま入場券になる。
  /// 鍵はこれ一本きりなので、当てられない長さにしてある。
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  shares      Share[]
}

model Membership {
  id         String    @id @default(cuid())
  userId     String
  placeId    String
  role       String    @default("member") // "owner" | "member"
  /// 前にこのグループを見た時刻。「ここから未読」の目印にだけ使う。数は出さない。
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([placeId])
}

/// 一篇。書いた人の日記に属する。投げたグループは Share で持つ（複数でよい）。
model Slip {
  id        String   @id @default(cuid())
  authorId  String
  /// 題。無くてよい。目次に出すときは、無ければ本文の一行目を借りる。
  title     String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  photo  Photo?
  shares Share[]

  @@index([authorId, createdAt])
}

/// 一篇をグループに投げた、その対応。無ければ自分のみ。
model Share {
  slipId    String
  placeId   String
  createdAt DateTime @default(now())

  slip  Slip  @relation(fields: [slipId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([slipId, placeId])
  @@index([placeId, createdAt])
}

/// 一枚だけ貼れる写真。
///
/// 実体を Slip に持たせると、巻物を出すたびに全員分のバイト列を引くことになる。
/// 表を分けて、一覧では大きさだけを読む。
model Photo {
  id        String   @id @default(cuid())
  slipId    String   @unique
  data      Bytes
  mimeType  String
  /// 出す前から縦横比が分かるように控えておく（読み込みで組みが動かないように）
  width     Int
  height    Int
  createdAt DateTime @default(now())

  slip Slip @relation(fields: [slipId], references: [id], onDelete: Cascade)
}
